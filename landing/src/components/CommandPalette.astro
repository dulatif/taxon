---
---

<div id="cmd-dialog" class="cmd-overlay" role="dialog" aria-modal="true" aria-label="Taxon Command Palette" hidden>
  <div class="cmd-backdrop" id="cmd-backdrop"></div>
  <div class="cmd-modal glass-card">
    <div class="cmd-header">
      <svg class="cmd-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="cmd-input"
        class="cmd-input"
        placeholder="Type a command or jump to feature..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="cmd-esc-hint">ESC</kbd>
    </div>

    <div class="cmd-list" id="cmd-list">
      <div class="cmd-group-label">NAVIGATION &amp; ARCHITECTURE</div>
      
      <a href="#workbench" class="cmd-item is-active" data-value="workbench dag graph interactive nodes">
        <span class="cmd-item-icon">⚡</span>
        <span class="cmd-item-title">Interactive DAG Graph Workbench</span>
        <span class="cmd-item-meta">Jump</span>
      </a>

      <a href="#features" class="cmd-item" data-value="features bento subsystem topology contract">
        <span class="cmd-item-icon">📦</span>
        <span class="cmd-item-title">Core Subsystems &amp; Artifact Chaining</span>
        <span class="cmd-item-meta">Jump</span>
      </a>

      <a href="#pipeline" class="cmd-item" data-value="pipeline multi-agent execution lifecycle">
        <span class="cmd-item-icon">🔄</span>
        <span class="cmd-item-title">4-Stage Multi-Agent Pipeline</span>
        <span class="cmd-item-meta">Jump</span>
      </a>

      <a href="#tui" class="cmd-item" data-value="tui pomodoro terminal keyboard velocity">
        <span class="cmd-item-icon">💻</span>
        <span class="cmd-item-title">Terminal TUI &amp; Pomodoro Focus</span>
        <span class="cmd-item-meta">Jump</span>
      </a>

      <a href="#download" class="cmd-item" data-value="download install linux macos windows cli curl">
        <span class="cmd-item-icon">⬇</span>
        <span class="cmd-item-title">Download Binaries &amp; CLI Installer</span>
        <span class="cmd-item-meta">Jump</span>
      </a>

      <div class="cmd-group-label">CLI ACTIONS</div>

      <button type="button" class="cmd-item" id="cmd-action-copy-cli" data-value="copy install cli curl bash">
        <span class="cmd-item-icon">$</span>
        <span class="cmd-item-title">curl -sSL https://taxon.run/install.sh | bash</span>
        <span class="cmd-item-meta">Copy</span>
      </button>

      <a href="https://github.com/nutlope/taxon" target="_blank" rel="noopener noreferrer" class="cmd-item" data-value="github repository star source code">
        <span class="cmd-item-icon">★</span>
        <span class="cmd-item-title">Star Taxon on GitHub</span>
        <span class="cmd-item-meta">External</span>
      </a>
    </div>

    <div class="cmd-footer">
      <span><kbd>↑</kbd> <kbd>↓</kbd> Navigate</span>
      <span><kbd>↵</kbd> Select</span>
      <span><kbd>ESC</kbd> Close</span>
    </div>
  </div>
</div>

<style>
  .cmd-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 14vh;
    padding-left: 1rem;
    padding-right: 1rem;
    font-family: var(--font-body);
  }

  .cmd-overlay[hidden] {
    display: none;
  }

  .cmd-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(5, 7, 10, 0.85);
    backdrop-filter: blur(8px);
  }

  .cmd-modal {
    position: relative;
    width: 100%;
    max-width: 600px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 30px -5px var(--accent-emerald-dim);
    overflow: hidden;
    animation: cmdAppear 120ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes cmdAppear {
    from { opacity: 0; transform: scale(0.98) translateY(-8px); }
    to { opacity: 1; transform: none; }
  }

  .cmd-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    background-color: var(--bg-card-header);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cmd-search-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .cmd-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 0.9375rem;
    font-family: var(--font-body);
    color: var(--text-primary);
  }

  .cmd-esc-hint {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.15rem 0.35rem;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    color: var(--text-muted);
  }

  .cmd-list {
    max-height: 340px;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .cmd-group-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-label);
    color: var(--text-dim);
    padding: 0.65rem 0.75rem 0.35rem;
  }

  .cmd-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-align: left;
    transition: all var(--t-fast);
  }

  .cmd-item:hover,
  .cmd-item.is-active {
    background-color: var(--accent-emerald-dim);
    color: var(--accent-emerald);
  }

  .cmd-item-icon {
    font-size: 0.9rem;
    width: 1.25rem;
    text-align: center;
  }

  .cmd-item-title {
    flex: 1;
    font-weight: 500;
  }

  .cmd-item-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .cmd-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.25rem;
    background-color: var(--bg-card-header);
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-dim);
  }

  .cmd-footer kbd {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
    padding: 0.1rem 0.3rem;
    color: var(--text-muted);
  }
</style>

<script>
  function setupCommandPalette() {
    const dialog = document.getElementById('cmd-dialog');
    const backdrop = document.getElementById('cmd-backdrop');
    const input = document.getElementById('cmd-input') as HTMLInputElement | null;
    const list = document.getElementById('cmd-list');
    const items = list ? Array.from(list.querySelectorAll('.cmd-item')) : [];
    const triggerButtons = document.querySelectorAll('[data-open-cmd]');
    const copyCliBtn = document.getElementById('cmd-action-copy-cli');

    function openDialog() {
      if (!dialog || !input) return;
      dialog.removeAttribute('hidden');
      input.value = '';
      filterItems('');
      input.focus();
      document.body.style.overflow = 'hidden';
    }

    function closeDialog() {
      if (!dialog) return;
      dialog.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }

    triggerButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openDialog();
      });
    });

    backdrop?.addEventListener('click', closeDialog);

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog?.hasAttribute('hidden')) {
          openDialog();
        } else {
          closeDialog();
        }
      } else if (e.key === 'Escape' && !dialog?.hasAttribute('hidden')) {
        e.preventDefault();
        closeDialog();
      }
    });

    function filterItems(query: string) {
      const q = query.toLowerCase().trim();
      items.forEach((item) => {
        const val = item.getAttribute('data-value') || '';
        const title = item.querySelector('.cmd-item-title')?.textContent || '';
        const match = !q || val.includes(q) || title.toLowerCase().includes(q);
        (item as HTMLElement).style.display = match ? 'flex' : 'none';
      });

      const visible = items.filter((i) => (i as HTMLElement).style.display !== 'none');
      items.forEach((i) => i.classList.remove('is-active'));
      if (visible.length > 0) {
        visible[0].classList.add('is-active');
      }
    }

    input?.addEventListener('input', (e) => {
      filterItems((e.target as HTMLInputElement).value);
    });

    input?.addEventListener('keydown', (e) => {
      const visible = items.filter((i) => (i as HTMLElement).style.display !== 'none');
      const activeIdx = visible.findIndex((i) => i.classList.contains('is-active'));

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const next = (activeIdx + 1) % visible.length;
        visible.forEach((i) => i.classList.remove('is-active'));
        visible[next]?.classList.add('is-active');
        visible[next]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = (activeIdx - 1 + visible.length) % visible.length;
        visible.forEach((i) => i.classList.remove('is-active'));
        visible[prev]?.classList.add('is-active');
        visible[prev]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const active = visible[activeIdx];
        if (active) {
          closeDialog();
          if (active.tagName === 'A') {
            (active as HTMLAnchorElement).click();
          } else if (active.tagName === 'BUTTON') {
            (active as HTMLButtonElement).click();
          }
        }
      }
    });

    copyCliBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText('curl -sSL https://taxon.run/install.sh | bash');
      alert('CLI command copied!');
      closeDialog();
    });

    items.forEach((item) => {
      item.addEventListener('click', () => {
        closeDialog();
      });
    });
  }

  setupCommandPalette();
  document.addEventListener('astro:page-load', setupCommandPalette);
</script>
