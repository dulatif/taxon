{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=1422 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit",
    "format": "biome check --write src/",
    "format:check": "biome check src/",
    "oxlint": "oxlint src/ --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "check-all": "pnpm run format:check && pnpm run oxlint && pnpm run lint && pnpm run type-check && pnpm run test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev -c src-tauri/tauri.dev.conf.json",
    "tauri:dev-gui": "[ -f \"$HOME/.cargo/env\" ] && . \"$HOME/.cargo/env\"; tauri dev -c src-tauri/tauri.dev.conf.json -- -- --gui",
    "cli:build": "[ -f \"$HOME/.cargo/env\" ] && . \"$HOME/.cargo/env\"; cargo build --release --manifest-path src-tauri/Cargo.toml -p taxon-cli",
    "cli:install": "[ -f \"$HOME/.cargo/env\" ] && . \"$HOME/.cargo/env\"; cargo install --path src-tauri/taxon-cli --force",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-global-shortcut": "~2.3.2",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "@tauri-apps/plugin-shell": "~2.3.5",
    "@tauri-apps/plugin-sql": "~2.4.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.16.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.1.0",
    "oxlint": "^1.74.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "pnpm exec biome check --write",
      "pnpm exec eslint --fix --max-warnings=0"
    ],
    "src/**/*.css": [
      "pnpm exec biome check --write"
    ]
  }
}
